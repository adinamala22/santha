{
  "name": "santha",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "openapi:gen": "pnpm --filter backend openapi:gen && pnpm --filter @santha/shared-types gen"
  }
}
