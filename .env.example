# Copy to .env (git-ignored). Values shown are local-dev placeholders only; production values live in AWS Secrets Manager.
NODE_ENV=development
APP_ENV=dev                      # dev | staging | production
PORT=4000
LOG_LEVEL=info                   # fatal|error|warn|info|debug|trace
CORS_ORIGINS=http://localhost:3000
RUN_WORKERS=true                 # API process also runs outbox relay + queue workers (prod: separate worker service)
OUTBOX_POLL_MS=500
DATA_STORE=postgres              # postgres | memory (local fake mode, no Docker; `pnpm dev:fake` sets it for you)
DATABASE_URL=postgresql://santha:santha@localhost:5432/santha
REDIS_URL=redis://localhost:6379
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=dev-typesense-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=santha-dev
S3_ACCESS_KEY=santha
S3_SECRET_KEY=santha-dev-only
CDN_BASE_URL=http://localhost:9000/santha-dev
JWT_ACCESS_SECRET=change-me-dev
JWT_REFRESH_SECRET=change-me-dev
JWT_ACCESS_TTL_SEC=900           # 15 min
JWT_REFRESH_TTL_SEC=2592000      # 30 days
OTP_PROVIDER=mock                # mock | msg91
MOCK_OTP_CODE=123456             # mock only: fixed code for local device testing (unset = random code, printed in the API log)
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_LIMIT_PER_PHONE_HOUR=5
OTP_LIMIT_PER_DEVICE_HOUR=10
OTP_LIMIT_PER_IP_HOUR=30
PAYMENTS_PROVIDER=mock           # mock | razorpay_sandbox | razorpay
MAPS_PROVIDER=mock               # mock | google | ola
KYC_PROVIDER=mock                # mock | digio | signzy
WHATSAPP_PROVIDER=mock           # mock | gupshup | interakt
THREEPL_PROVIDER=mock            # mock | porter | shadowfax
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Provider credentials (never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_SERVER_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
KYC_API_KEY=
# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
