# Copy to .env (git-ignored). Values shown are local-dev placeholders only; production values live in AWS Secrets Manager.
NODE_ENV=development
APP_ENV=dev                      # dev | staging | production
PORT=4000
LOG_LEVEL=info                   # fatal|error|warn|info|debug|trace
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (1 behind Caddy on the servers; 0 locally). Needed for per-IP rate limits.
TRUST_PROXY=0
# test | prod: load config/values/<env>.values.yaml (servers set this; leave empty locally). Optional overlay: SANTHA_CLOUD.
SANTHA_ENV=
SANTHA_CLOUD=
RUN_WORKERS=true                 # API process also runs outbox relay + queue workers (prod: separate worker service)
OUTBOX_POLL_MS=500
DATA_STORE=postgres              # postgres | memory (local fake mode, no Docker; `pnpm dev:fake` sets it for you)
DATABASE_URL=postgresql://santha:santha@localhost:5432/santha
REDIS_URL=redis://localhost:6379
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_PROTOCOL=http
TYPESENSE_PREFIX=                          # collection name prefix (tests/environments sharing one Typesense)
SEARCH_ENGINE=                             # typesense (default with Postgres) | memory; fake mode always memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=santha-dev
S3_ACCESS_KEY=santha
S3_SECRET_KEY=santha-dev-only
S3_REGION=ap-south-1
MAX_UPLOAD_BYTES=8388608                   # photo uploads (8 MB)
CDN_BASE_URL=http://localhost:9000/santha-dev
JWT_ACCESS_SECRET=change-me-dev
JWT_REFRESH_SECRET=change-me-dev
JWT_ACCESS_TTL_SEC=900           # 15 min
JWT_REFRESH_TTL_SEC=2592000      # 30 days
OTP_PROVIDER=mock                # mock | msg91
MOCK_OTP_CODE=123456             # mock only: fixed code for local device testing (unset = random code, printed in the API log)
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_LIMIT_PER_PHONE_HOUR=5
OTP_LIMIT_PER_DEVICE_HOUR=10
OTP_LIMIT_PER_IP_HOUR=30
PAYMENTS_PROVIDER=mock           # mock | razorpay_sandbox (test keys) | razorpay (live, production only); fake mode is always mock
PAYMENT_WINDOW_MIN=15            # online orders not paid within this many minutes become PAYMENT_FAILED
QUOTE_TTL_MIN=30                 # a checkout quote stays valid this long
MAPS_PROVIDER=mock               # mock | google (Routes API, needs GOOGLE_MAPS_SERVER_KEY); ETA travel times
BARCODE_PROVIDER=mock            # mock | openfoodfacts (fallback for barcodes missing from the master catalogue)
STALENESS_SWEEP_MIN=60           # catalogue staleness sweep interval (minutes)
KYC_PROVIDER=mock                # mock | digio | signzy
PUSH_PROVIDER=mock               # mock | fcm (needs FCM_SERVICE_ACCOUNT_B64: base64 of the Firebase service-account JSON)
FCM_SERVICE_ACCOUNT_B64=
# WhatsApp login OTP (flag whatsapp_otp; ADR-017). mock | cloud (Meta WhatsApp Cloud API). SMS stays the fallback.
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=           # secret: System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp Manager → API setup → Phone number ID
WHATSAPP_OTP_TEMPLATE=santha_login_otp   # approved authentication template (en + te)
THREEPL_PROVIDER=mock            # mock only for now (porter / shadowfax adapters later)
MOCK_3PL_AVAILABLE=false         # mock 3PL: true = books a courier, false = no capacity (fallback ladder continues)
WEB_BASE_URL=http://localhost:3000   # staff delivery links /d/{token}
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Provider credentials (never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_SERVER_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
KYC_PROVIDER=mock                # mock | digio (PAN, Aadhaar eKYC, GSTIN, FSSAI, penny-drop); mock refused in production
FLAG_OVERRIDES=                  # local feature-flag overrides, JSON, e.g. {"cod_payments":false}
OPS_REFRESH_TTL_SEC=28800        # ops console sessions (8 h)
OPS_LOGIN_LIMIT_PER_EMAIL_HOUR=10  # ops password attempts per email per hour
OPS_LOGIN_LIMIT_PER_IP_HOUR=30
SEED_OPS_PASSWORD=santha-admin-dev  # DEV ONLY: password of the seeded admin@santha.local (seed refuses APP_ENV != dev)
KYC_API_KEY=
# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000                 # server-side calls from the ops console (defaults to NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_MAP_TILES_URL=                     # raster tiles for the console map; empty = OpenStreetMap (ADR-007)
