  "info": {
    "title": "Santha API",
    "description": "Santha hyperlocal marketplace — REST /v1. Generated from NestJS decorators; do not edit by hand.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ReadinessDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "latencyMs": {
                    "type": "number"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "ok",
                  "latencyMs"
                ],
                "additionalProperties": false
              },
              "redis": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "latencyMs": {
                    "type": "number"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "ok",
                  "latencyMs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "postgres",
              "redis"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 10,
            "maxLength": 16,
            "description": "Indian mobile; normalised to +91XXXXXXXXXX"
          },
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Stable per-install id generated by the app and kept in secure storage"
          },
          "app": {
            "type": "string",
            "enum": [
              "consumer",
              "merchant",
              "rider"
            ],
            "description": "Which Santha app is signing in"
          },
          "locale": {
            "description": "Language for the SMS",
            "type": "string",
            "enum": [
              "en",
              "te"
            ]
          }
        },
        "required": [
          "phone",
          "deviceId",
          "app"
        ]
      },
      "OtpChallengeDto_Output": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expiresInSec": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "resendAfterSec": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "challengeId",
          "expiresInSec",
          "resendAfterSec"
        ],
        "additionalProperties": false
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Stable per-install id generated by the app and kept in secure storage"
          },
          "app": {
            "type": "string",
            "enum": [
              "consumer",
              "merchant",
              "rider"
            ],
            "description": "Which Santha app is signing in"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios",
              "web"
            ]
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "challengeId",
          "code",
          "deviceId",
          "app",
          "platform"
        ]
      },
      "AuthSessionDto_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "seconds"
          },
          "refreshExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "seconds"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "phoneMasked": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "locale": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "consumer",
                    "merchant",
                    "merchant_staff",
                    "rider",
                    "admin",
                    "ops",
                    "finance",
                    "support"
                  ]
                }
              }
            },
            "required": [
              "id",
              "phoneMasked",
              "name",
              "locale",
              "roles"
            ],
            "additionalProperties": false
          },
          "isNewUser": {
            "type": "boolean"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessExpiresIn",
          "refreshExpiresIn",
          "user",
          "isNewUser"
        ],
        "additionalProperties": false
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 10,
            "maxLength": 512
          },
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Stable per-install id generated by the app and kept in secure storage"
          }
        },
        "required": [
          "refreshToken",
          "deviceId"
        ]
      },
      "TokenPairDto_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "seconds"
          },
          "refreshExpiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "seconds"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessExpiresIn",
          "refreshExpiresIn"
        ],
        "additionalProperties": false
      },
      "MeDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "phoneMasked": {
            "type": "string"
          },
          "name": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locale": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consumer",
                "merchant",
                "merchant_staff",
                "rider",
                "admin",
                "ops",
                "finance",
                "support"
              ]
            }
          }
        },
        "required": [
          "id",
          "phoneMasked",
          "name",
          "locale",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  }
}
