// Santha — single Prisma schema. Module ownership is noted per model; only the owning
// module's repository may query a model (see .claude/skills/santha-architecture).
// Money = Int paise. Timestamps = timestamptz. Geo = PostGIS geography via raw SQL (src/infra/prisma/geo.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ───────────── identity-kyc ─────────────

enum UserStatus {
  active
  blocked
  deleted
}

enum Role {
  consumer
  merchant
  merchant_staff
  rider
  admin
  ops
  finance
  support
}

enum AppId {
  consumer
  merchant
  rider
  web_admin
}

enum Platform {
  android
  ios
  web
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique // E.164, +91XXXXXXXXXX
  name         String?
  locale       String     @default("en")
  status       UserStatus @default(active)
  /// Ops console accounts only: email + password, then OTP to `phone` as second factor.
  email        String?    @unique
  passwordHash String?    @map("password_hash")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles    UserRole[]
  devices  Device[]
  sessions Session[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedBy String?  @map("granted_by") @db.Uuid // null = self-service signup
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// A physical install of one of our apps, bound to a user. Tokens are bound to a device.
model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") // client-generated install id, stored in secure storage
  app        AppId
  platform   Platform
  appVersion String?  @map("app_version")
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceId, app])
  @@index([deviceId])
  @@map("devices")
}

/// One refresh-token session per device login. The refresh secret rotates on every refresh;
/// presenting the previous secret again is treated as token theft and revokes the session.
model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceRowId     String    @map("device_row_id") @db.Uuid
  refreshHash     String    @map("refresh_hash")
  prevRefreshHash String?   @map("prev_refresh_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason")
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceRowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  deviceId   String    @map("device_id")
  app        AppId
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

enum KycSubject {
  merchant
  rider
}

enum KycKind {
  pan
  aadhaar
  gstin
  gst_exemption
  fssai
  bank
  drug_licence
}

enum KycStatus {
  pending // e.g. Aadhaar OTP sent, waiting for the code
  verified
  failed
}

/// One verification per (subject, kind); re-running a check replaces the row.
/// PAN, Aadhaar and bank numbers are never stored in full — only masked values and provider references.
/// GSTIN, FSSAI and drug-licence numbers are public business identifiers and are stored in full.
model KycCheck {
  id            String     @id @default(uuid()) @db.Uuid
  subjectType   KycSubject @map("subject_type")
  subjectId     String     @map("subject_id") @db.Uuid
  kind          KycKind
  status        KycStatus
  valueMasked   String?    @map("value_masked")
  valuePublic   String?    @map("value_public")
  nameOnRecord  String?    @map("name_on_record")
  provider      String
  providerRef   String?    @map("provider_ref")
  failureReason String?    @map("failure_reason")
  details       Json?
  verifiedAt    DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectId, kind])
  @@map("kyc_checks")
}

// ───────────── analytics-config ─────────────

model City {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  nameTe    String   @map("name_te")
  state     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  microMarkets MicroMarket[]

  @@map("cities")
}

model MicroMarket {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  slug      String   @unique
  name      String
  nameTe    String   @map("name_te")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  city     City                 @relation(fields: [cityId], references: [id])
  versions MicroMarketVersion[]

  @@index([cityId])
  @@map("micro_markets")
}

/// Versioned configuration: exactly one version is effective at any instant
/// (effective_from <= t < effective_to, effective_to null = open-ended). Never updated in place
/// except to close the previous version when a new one is added, so past orders can be re-priced.
model MicroMarketVersion {
  id            String                                    @id @default(uuid()) @db.Uuid
  microMarketId String                                    @map("micro_market_id") @db.Uuid
  version       Int
  effectiveFrom DateTime                                  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?                                 @map("effective_to") @db.Timestamptz(6)
  /// Always set (enforced by the service); nullable only because Prisma cannot write geography.
  polygon       Unsupported("geography(Polygon, 4326)")?
  hours         Json
  fees          Json
  cod           Json
  sla           Json
  riderPay      Json                                      @map("rider_pay")
  note          String?
  createdBy     String?                                   @map("created_by") @db.Uuid
  createdAt     DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(6)

  microMarket MicroMarket @relation(fields: [microMarketId], references: [id], onDelete: Cascade)

  @@unique([microMarketId, version])
  @@index([microMarketId, effectiveFrom])
  @@map("micro_market_versions")
}

// ───────────── merchant-catalogue ─────────────

enum MerchantType {
  retail
  fashion
  home_business
  home_kitchen
}

enum MerchantStatus {
  draft
  submitted
  approved
  rejected
  live
}

enum FulfilmentMode {
  self
  rider
}

model Merchant {
  id                String                                  @id @default(uuid()) @db.Uuid
  ownerUserId       String                                  @unique @map("owner_user_id") @db.Uuid // MVP: one store per owner
  microMarketId     String?                                 @map("micro_market_id") @db.Uuid
  type              MerchantType
  sellsFood         Boolean                                 @default(false) @map("sells_food")
  category          String?
  name              String
  nameTe            String?                                 @map("name_te")
  description       String?
  addressLine       String?                                 @map("address_line")
  landmark          String?
  pincode           String?
  location          Unsupported("geography(Point, 4326)")?
  radiusM           Int                                     @default(3000) @map("radius_m")
  hours             Json?
  movPaise          Int                                     @default(0) @map("mov_paise")
  defaultFulfilment FulfilmentMode                          @default(rider) @map("default_fulfilment")
  returnPolicy      String?                                 @map("return_policy")
  hygieneDeclaredAt DateTime?                               @map("hygiene_declared_at") @db.Timestamptz(6)
  status            MerchantStatus                          @default(draft)
  submittedAt       DateTime?                               @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?                               @map("decided_at") @db.Timestamptz(6)
  decidedBy         String?                                 @map("decided_by") @db.Uuid
  rejectionCode     String?                                 @map("rejection_code")
  rejectionNote     String?                                 @map("rejection_note")
  liveAt            DateTime?                               @map("live_at") @db.Timestamptz(6)
  createdAt         DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff MerchantStaff[]

  @@index([status, submittedAt])
  @@index([microMarketId, status])
  @@map("merchants")
}

/// Store staff who can self-deliver (they get a tracking link per job, M6).
model MerchantStaff {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  name       String
  phone      String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, phone])
  @@map("merchant_staff")
}

// ───────────── platform (shared infrastructure, owned by src/infra) ─────────────

/// Transactional outbox. Written in the same transaction as the state change; relayed to BullMQ `events`.
model OutboxEvent {
  id            String    @id @db.Uuid // = event_id
  type          String // e.g. user.registered
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  microMarketId String?   @map("micro_market_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox")
}

/// Consumer-side dedupe: one row per (event, consumer) once handled.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// Every ops mutation writes one of these (entity, action, actor, before, after).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  entity        String
  entityId      String   @map("entity_id")
  action        String
  actorId       String?  @map("actor_id") @db.Uuid
  microMarketId String?  @map("micro_market_id") @db.Uuid
  before        Json?
  after         Json?
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
