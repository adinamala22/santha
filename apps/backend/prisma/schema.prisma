// Santha — single Prisma schema. Module ownership is noted per model; only the owning
// module's repository may query a model (see .claude/skills/santha-architecture).
// Money = Int paise. Timestamps = timestamptz. Geo = PostGIS geography via raw SQL (src/infra/prisma/geo.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ───────────── identity-kyc ─────────────

/// A consumer's saved delivery address (up to 10, FR-LOC-1). The exact address is shown to the
/// merchant only after acceptance and to the rider only after assignment.
model Address {
  id            String                                 @id @default(uuid()) @db.Uuid
  userId        String                                 @map("user_id") @db.Uuid
  label         String // home | work | other
  name          String? // custom label for "other"
  line          String // house / flat, building, street
  landmark      String?
  pincode       String?
  location      Unsupported("geography(Point, 4326)")?
  microMarketId String?                                @map("micro_market_id") @db.Uuid
  isDefault     Boolean                                @default(false) @map("is_default")
  createdAt     DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

enum UserStatus {
  active
  blocked
  deleted
}

enum Role {
  consumer
  merchant
  merchant_staff
  rider
  admin
  ops
  finance
  support
}

enum AppId {
  consumer
  merchant
  rider
  web_admin
}

enum Platform {
  android
  ios
  web
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique // E.164, +91XXXXXXXXXX
  name         String?
  locale       String     @default("en")
  status       UserStatus @default(active)
  /// Ops console accounts only: email + password, then OTP to `phone` as second factor.
  email        String?    @unique
  passwordHash String?    @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles     UserRole[]
  devices   Device[]
  sessions  Session[]
  addresses Address[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedBy String?  @map("granted_by") @db.Uuid // null = self-service signup
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// A physical install of one of our apps, bound to a user. Tokens are bound to a device.
model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") // client-generated install id, stored in secure storage
  app        AppId
  platform   Platform
  appVersion String?  @map("app_version")
  pushToken  String?  @map("push_token")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceId, app])
  @@index([deviceId])
  @@map("devices")
}

/// One refresh-token session per device login. The refresh secret rotates on every refresh;
/// presenting the previous secret again is treated as token theft and revokes the session.
model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceRowId     String    @map("device_row_id") @db.Uuid
  refreshHash     String    @map("refresh_hash")
  prevRefreshHash String?   @map("prev_refresh_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason")
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceRowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  deviceId   String    @map("device_id")
  app        AppId
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

enum KycSubject {
  merchant
  rider
}

enum KycKind {
  pan
  aadhaar
  gstin
  gst_exemption
  fssai
  bank
  drug_licence
}

enum KycStatus {
  pending // e.g. Aadhaar OTP sent, waiting for the code
  verified
  failed
}

/// One verification per (subject, kind); re-running a check replaces the row.
/// PAN, Aadhaar and bank numbers are never stored in full — only masked values and provider references.
/// GSTIN, FSSAI and drug-licence numbers are public business identifiers and are stored in full.
model KycCheck {
  id            String     @id @default(uuid()) @db.Uuid
  subjectType   KycSubject @map("subject_type")
  subjectId     String     @map("subject_id") @db.Uuid
  kind          KycKind
  status        KycStatus
  valueMasked   String?    @map("value_masked")
  valuePublic   String?    @map("value_public")
  nameOnRecord  String?    @map("name_on_record")
  provider      String
  providerRef   String?    @map("provider_ref")
  failureReason String?    @map("failure_reason")
  details       Json?
  verifiedAt    DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectId, kind])
  @@map("kyc_checks")
}

// ───────────── analytics-config ─────────────

model City {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  nameTe    String   @map("name_te")
  state     String
  /// City-wide coverage (ADR-019): { nearestFallback, maxDistanceM }; {} = areas only.
  coverage  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  microMarkets MicroMarket[]

  @@map("cities")
}

model MicroMarket {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  slug      String   @unique
  name      String
  nameTe    String   @map("name_te")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  city     City                 @relation(fields: [cityId], references: [id])
  versions MicroMarketVersion[]

  @@index([cityId])
  @@map("micro_markets")
}

/// Versioned configuration: exactly one version is effective at any instant
/// (effective_from <= t < effective_to, effective_to null = open-ended). Never updated in place
/// except to close the previous version when a new one is added, so past orders can be re-priced.
model MicroMarketVersion {
  id            String                                   @id @default(uuid()) @db.Uuid
  microMarketId String                                   @map("micro_market_id") @db.Uuid
  version       Int
  effectiveFrom DateTime                                 @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?                                @map("effective_to") @db.Timestamptz(6)
  /// Always set (enforced by the service); nullable only because Prisma cannot write geography.
  polygon       Unsupported("geography(Polygon, 4326)")?
  hours         Json
  fees          Json
  cod           Json
  sla           Json
  riderPay      Json                                     @map("rider_pay")
  /// Ranking weights and ETA defaults for search-discovery (M2). Older rows read as defaults.
  discovery     Json                                     @default("{}")
  note          String?
  createdBy     String?                                  @map("created_by") @db.Uuid
  createdAt     DateTime                                 @default(now()) @map("created_at") @db.Timestamptz(6)

  microMarket MicroMarket @relation(fields: [microMarketId], references: [id], onDelete: Cascade)

  @@unique([microMarketId, version])
  @@index([microMarketId, effectiveFrom])
  @@map("micro_market_versions")
}

// ───────────── merchant-catalogue ─────────────

enum MerchantType {
  retail
  fashion
  home_business
  home_kitchen
}

enum MerchantStatus {
  draft
  submitted
  approved
  rejected
  live
}

enum FulfilmentMode {
  self
  rider
}

model Merchant {
  id                String                                 @id @default(uuid()) @db.Uuid
  /// Public store link /s/{slug} (M8), set when the store goes live.
  slug              String?                                @unique
  ownerUserId       String                                 @unique @map("owner_user_id") @db.Uuid // MVP: one store per owner
  microMarketId     String?                                @map("micro_market_id") @db.Uuid
  type              MerchantType
  sellsFood         Boolean                                @default(false) @map("sells_food")
  category          String?
  name              String
  nameTe            String?                                @map("name_te")
  description       String?
  addressLine       String?                                @map("address_line")
  landmark          String?
  pincode           String?
  location          Unsupported("geography(Point, 4326)")?
  radiusM           Int                                    @default(3000) @map("radius_m")
  hours             Json?
  movPaise          Int                                    @default(0) @map("mov_paise")
  /// Per-order packaging charge set by the merchant; cart-pricing caps it at the fee rule.
  packagingFeePaise Int                                    @default(0) @map("packaging_fee_paise")
  defaultFulfilment FulfilmentMode                         @default(rider) @map("default_fulfilment")
  returnPolicy      String?                                @map("return_policy")
  hygieneDeclaredAt DateTime?                              @map("hygiene_declared_at") @db.Timestamptz(6)
  status            MerchantStatus                         @default(draft)
  submittedAt       DateTime?                              @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?                              @map("decided_at") @db.Timestamptz(6)
  decidedBy         String?                                @map("decided_by") @db.Uuid
  rejectionCode     String?                                @map("rejection_code")
  rejectionNote     String?                                @map("rejection_note")
  liveAt            DateTime?                              @map("live_at") @db.Timestamptz(6)
  /// Store toggle (merchant app) and auto-pause after two missed orders in a row (M5).
  acceptingOrders   Boolean                                @default(true) @map("accepting_orders")
  pausedReason      String?                                @map("paused_reason")
  pausedAt          DateTime?                              @map("paused_at") @db.Timestamptz(6)
  missedInARow      Int                                    @default(0) @map("missed_in_a_row")
  createdAt         DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Store photos (media ids, in display order). Shown once moderation approves them.
  photoIds String[] @default([]) @map("photo_ids") @db.Uuid

  staff MerchantStaff[]
  items Item[]
  slots KitchenSlot[]

  @@index([status, submittedAt])
  @@index([microMarketId, status])
  @@map("merchants")
}

/// Store staff who can self-deliver (they get a tracking link per job, M6).
model MerchantStaff {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  name       String
  phone      String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, phone])
  @@map("merchant_staff")
}

// ───────────── merchant-catalogue: catalogue (M2) ─────────────

enum MasterSource {
  seed
  import
  open_barcode
  ops
}

/// Packaged goods (GS1 / commercial source + own enrichment). Merchant scans resolve here.
model MasterProduct {
  id           String       @id @default(uuid()) @db.Uuid
  barcode      String       @unique // GTIN-8/12/13/14, check digit validated
  name         String
  brand        String?
  mrpPaise     Int?         @map("mrp_paise")
  packLabel    String?      @map("pack_label") // "5 kg", "500 ml"
  unit         ItemUnit?
  unitQty      Float?       @map("unit_qty")
  categorySlug String       @map("category_slug")
  imageUrl     String?      @map("image_url")
  source       MasterSource
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  items Item[]

  @@index([categorySlug])
  @@map("master_products")
}

/// Ops enrichment queue: scanned barcodes that resolved nowhere (FR-CAT-1).
model BarcodeRequest {
  id              String    @id @default(uuid()) @db.Uuid
  barcode         String    @unique
  scanCount       Int       @default(1) @map("scan_count")
  lastMerchantId  String?   @map("last_merchant_id") @db.Uuid
  status          String    @default("open") // open | resolved
  masterProductId String?   @map("master_product_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?   @map("resolved_by") @db.Uuid

  @@index([status, createdAt])
  @@map("barcode_requests")
}

enum ItemStatus {
  pending_merchant // built by ops on the merchant's behalf, awaiting merchant approval (FR-CAT-3)
  in_review // held by the prohibited-item check (FR-CAT-7)
  active
  hidden
}

enum ItemSource {
  merchant
  master
  import
  ops
}

enum FoodMark {
  veg
  non_veg
  egg
}

enum ItemUnit {
  kg
  g
  l
  ml
  pc
  pack
  portion
}

enum StockState {
  in
  low
  out
}

/// A merchant's SKU. Price and stock live on its variants. Soft-deleted only (deleted_at).
model Item {
  id              String     @id @default(uuid()) @db.Uuid
  merchantId      String     @map("merchant_id") @db.Uuid
  microMarketId   String?    @map("micro_market_id") @db.Uuid
  masterProductId String?    @map("master_product_id") @db.Uuid
  name            String
  nameTe          String?    @map("name_te")
  description     String?
  brand           String?
  categorySlug    String     @map("category_slug")
  foodMark        FoodMark?  @map("food_mark")
  allergens       String[]   @default([])
  madeToOrder     Boolean    @default(false) @map("made_to_order")
  leadTimeMin     Int?       @map("lead_time_min")
  maxPerOrder     Int?       @map("max_per_order")
  /// Home kitchens: menu days (empty = every day), portions per day, and the day it is "today's special".
  availableDays   String[]   @default([]) @map("available_days")
  dailyCapacity   Int?       @map("daily_capacity")
  specialOn       String?    @map("special_on") // YYYY-MM-DD, Asia/Kolkata
  status          ItemStatus
  reviewReason    String?    @map("review_reason")
  source          ItemSource
  imageIds        String[]   @default([]) @map("image_ids") @db.Uuid
  /// Last time the merchant confirmed price/stock; untouched for staleCatalogueHours → stale.
  confirmedAt     DateTime   @map("confirmed_at") @db.Timestamptz(6)
  staleSince      DateTime?  @map("stale_since") @db.Timestamptz(6)
  createdBy       String?    @map("created_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct? @relation(fields: [masterProductId], references: [id])
  variants      ItemVariant[]

  @@index([merchantId, status])
  @@index([status, confirmedAt])
  @@map("items")
}

model ItemVariant {
  id         String     @id @default(uuid()) @db.Uuid
  itemId     String     @map("item_id") @db.Uuid
  label      String // "500 g", "Large", "Serves 2"
  unit       ItemUnit
  unitQty    Float      @map("unit_qty")
  pricePaise Int        @map("price_paise")
  mrpPaise   Int?       @map("mrp_paise")
  stock      StockState @default(in)
  position   Int        @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
  @@map("item_variants")
}

/// Home-kitchen delivery slots (FR-CAT-5). Times are Asia/Kolkata.
model KitchenSlot {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  label      String?
  days       String[] // mon..sun
  start      String // HH:MM
  end        String // HH:MM
  cutoffMin  Int      @map("cutoff_min") // orders close this many minutes before start
  capacity   Int // orders per slot per day
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("kitchen_slots")
}

enum MediaStatus {
  uploading
  pending_review
  approved
  rejected
}

/// Uploaded images (item and store photos). `variants` are the WebP renditions made by Sharp.
model Media {
  id           String      @id @default(uuid()) @db.Uuid
  merchantId   String      @map("merchant_id") @db.Uuid
  purpose      String // item | store
  status       MediaStatus
  contentType  String      @map("content_type")
  originalKey  String      @map("original_key")
  variants     Json?
  rejectReason String?     @map("reject_reason")
  uploadedBy   String?     @map("uploaded_by") @db.Uuid
  reviewedBy   String?     @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([merchantId])
  @@map("media")
}

// ───────────── platform (shared infrastructure, owned by src/infra) ─────────────

/// Transactional outbox. Written in the same transaction as the state change; relayed to BullMQ `events`.
model OutboxEvent {
  id            String    @id @db.Uuid // = event_id
  type          String // e.g. user.registered
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  microMarketId String?   @map("micro_market_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@map("outbox")
}

/// Consumer-side dedupe: one row per (event, consumer) once handled.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// Every ops mutation writes one of these (entity, action, actor, before, after).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  entity        String
  entityId      String   @map("entity_id")
  action        String
  actorId       String?  @map("actor_id") @db.Uuid
  microMarketId String?  @map("micro_market_id") @db.Uuid
  before        Json?
  after         Json?
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

// ───────────── cart-pricing (M4) ─────────────

/// One open cart per consumer, for one store at a time (multi-store carts are Phase 2).
model Cart {
  userId     String   @id @map("user_id") @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  /// [{ itemId, variantId, quantity, substitution }]
  lines      Json
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("carts")
}

/// Every price shown at checkout is snapshotted; POST /orders places exactly what was quoted.
model Quote {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  microMarketId String   @map("micro_market_id") @db.Uuid
  totalPaise    Int      @map("total_paise")
  /// Full computeQuote result plus the inputs it was computed from.
  snapshot      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("quotes")
}

enum PromoKind {
  flat
  percent
}

/// Coupon codes with budgets and limits. Ops edit them with audit.
model Promo {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String         @unique
  description          String
  descriptionTe        String         @map("description_te")
  kind                 PromoKind
  /// flat: paise off; percent: whole percent off.
  value                Int
  maxDiscountPaise     Int?           @map("max_discount_paise")
  minOrderPaise        Int            @default(0) @map("min_order_paise")
  /// Total discount that may be given; null = unlimited.
  budgetPaise          Int?           @map("budget_paise")
  /// Reserved + used discount so far (released when an order fails before placement).
  spentPaise           Int            @default(0) @map("spent_paise")
  perUserLimit         Int            @default(1) @map("per_user_limit")
  firstOrderOnly       Boolean        @default(false) @map("first_order_only")
  /// Share of the discount the merchant funds (0-100); the rest is platform-funded.
  merchantSharePercent Int            @default(0) @map("merchant_share_percent")
  /// Empty = every micro-market / supply type / store.
  microMarketIds       String[]       @default([]) @map("micro_market_ids") @db.Uuid
  merchantTypes        MerchantType[] @default([]) @map("merchant_types")
  merchantIds          String[]       @default([]) @map("merchant_ids") @db.Uuid
  validFrom            DateTime       @map("valid_from") @db.Timestamptz(6)
  validTo              DateTime?      @map("valid_to") @db.Timestamptz(6)
  active               Boolean        @default(true)
  createdBy            String?        @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  redemptions PromoRedemption[]

  @@map("promos")
}

enum RedemptionStatus {
  reserved
  confirmed
  released
}

model PromoRedemption {
  id                 String           @id @default(uuid()) @db.Uuid
  promoId            String           @map("promo_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  orderId            String           @unique @map("order_id") @db.Uuid
  discountPaise      Int              @map("discount_paise")
  merchantSharePaise Int              @map("merchant_share_paise")
  status             RedemptionStatus
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  promo Promo @relation(fields: [promoId], references: [id])

  @@index([promoId, userId])
  @@map("promo_redemptions")
}

// ───────────── orders (M4) ─────────────

/// Lifecycle in references/order-state-machine.md. AWAITING_PAYMENT and PAYMENT_FAILED come before
/// the lifecycle for online payments: an order becomes PLACED only after capture or COD authorisation.
enum OrderState {
  AWAITING_PAYMENT
  PAYMENT_FAILED
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  EXPIRED
  FAILED_DELIVERY
}

enum PaymentMethod {
  online
  cod
}

/// Only orders/domain/state-machine.ts decides `state` (written through OrderRepository.transition).
model Order {
  id             String        @id @db.Uuid
  /// Short code shown to customers and merchants, e.g. "SN4K7Q2".
  code           String        @unique
  userId         String        @map("user_id") @db.Uuid
  merchantId     String        @map("merchant_id") @db.Uuid
  microMarketId  String        @map("micro_market_id") @db.Uuid
  state          OrderState
  paymentMethod  PaymentMethod @map("payment_method")
  /// asap | slot (home kitchens)
  fulfilmentWhen String        @map("fulfilment_when")
  slotId         String?       @map("slot_id") @db.Uuid
  slotDate       String?       @map("slot_date")
  slotStartsAt   DateTime?     @map("slot_starts_at") @db.Timestamptz(6)
  /// Delivery address at ordering time (revealed to the merchant only after acceptance).
  address        Json
  instructions   String?
  itemsPaise     Int           @map("items_paise")
  feesPaise      Int           @map("fees_paise")
  taxPaise       Int           @map("tax_paise")
  discountPaise  Int           @map("discount_paise")
  totalPaise     Int           @map("total_paise")
  promoCode      String?       @map("promo_code")
  /// The quote the customer accepted: the bill of record.
  quote          Json
  idempotencyKey String        @map("idempotency_key")
  placedAt       DateTime?     @map("placed_at") @db.Timestamptz(6)
  paymentDueAt   DateTime?     @map("payment_due_at") @db.Timestamptz(6)
  /// M5 lifecycle: how the merchant fulfils (self | rider), when it was accepted / ready, refunds so far.
  fulfilmentMode String?       @map("fulfilment_mode")
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz(6)
  readyAt        DateTime?     @map("ready_at") @db.Timestamptz(6)
  packBy         DateTime?     @map("pack_by") @db.Timestamptz(6)
  refundedPaise  Int           @default(0) @map("refunded_paise")
  /// Reject / cancel reason code.
  outcomeReason  String?       @map("outcome_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  lines   OrderLine[]
  history OrderTransition[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([merchantId, state])
  @@index([state, paymentDueAt])
  @@index([merchantId, slotId, slotDate])
  @@map("orders")
}

model OrderLine {
  id                     String  @id @default(uuid()) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  itemId                 String  @map("item_id") @db.Uuid
  variantId              String  @map("variant_id") @db.Uuid
  name                   String
  variantLabel           String  @map("variant_label")
  quantity               Int
  unitPricePaise         Int     @map("unit_price_paise")
  mrpPaise               Int?    @map("mrp_paise")
  linePaise              Int     @map("line_paise")
  /// call_me | similar | remove: what to do if the item is unavailable when packing.
  substitution           String
  position               Int     @default(0)
  /// ok | removed | substituted (merchant marks unavailable items while packing).
  status                 String  @default("ok")
  substituteItemId       String? @map("substitute_item_id") @db.Uuid
  substituteVariantId    String? @map("substitute_variant_id") @db.Uuid
  substituteName         String? @map("substitute_name")
  substituteVariantLabel String? @map("substitute_variant_label")
  substituteUnitPaise    Int?    @map("substitute_unit_paise")
  /// Money given back for this line (removed, or substituted for less).
  refundPaise            Int     @default(0) @map("refund_paise")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_lines")
}

/// Append-only history of every state change (actor and reason).
model OrderTransition {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  from      OrderState?
  to        OrderState
  actorType String      @map("actor_type")
  actorId   String?     @map("actor_id") @db.Uuid
  reason    String?
  at        DateTime    @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_transitions")
}

// ───────────── payments-settlement (M4) ─────────────

enum PaymentStatus {
  created
  captured
  failed
}

/// One payment attempt for an online order (provider order <-> our order).
model PaymentIntent {
  id                String        @id @db.Uuid
  orderId           String        @unique @map("order_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  microMarketId     String        @map("micro_market_id") @db.Uuid
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  provider          String
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("payment_intents")
}

/// Raw provider webhooks, stored after signature verification and deduped by provider event id.
model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

/// Wallet ledger: refund credits only in the MVP (no top-ups). Balance = sum of entries.
model WalletEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  /// refund_credit | adjustment
  kind        String
  orderId     String?  @map("order_id") @db.Uuid
  note        String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

// ───────────── notifications (M5) ─────────────

/// Every message sent to a customer, merchant or rider, per channel — the ops comms log.
model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  merchantId String?  @map("merchant_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  /// push | sms | whatsapp | voice | socket
  channel    String
  template   String
  locale     String
  body       String
  /// sent | failed | skipped
  status     String
  provider   String
  error      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// FCM registration tokens per device.
model PushToken {
  deviceId  String   @id @map("device_id")
  userId    String   @map("user_id") @db.Uuid
  token     String
  platform  String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_tokens")
}

/// Opt-ins (WhatsApp order updates need explicit consent).
model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  whatsappUpdates Boolean  @default(false) @map("whatsapp_updates")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

// ───────────── dispatch-tracking (M6) ─────────────

/// Delivery partner profile (users with the rider role). Live positions live in Redis GEO, not here.
model Rider {
  userId         String    @id @map("user_id") @db.Uuid
  name           String
  vehicle        String    @default("bike")
  /// Micro-markets the rider works in (chosen when going online).
  zones          String[]  @db.Uuid
  online         Boolean   @default(false)
  rating         Float?
  offersShown    Int       @default(0) @map("offers_shown")
  offersAccepted Int       @default(0) @map("offers_accepted")
  onlineSince    DateTime? @map("online_since") @db.Timestamptz(6)
  /// Minutes online before today's session (resets daily).
  onlineMinToday Int       @default(0) @map("online_min_today")
  /// weekly (default) | daily payouts (M7)
  payoutCadence  String    @default("weekly") @map("payout_cadence")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("riders")
}

/// How one order reaches the customer: the store's staff (self), a Santha rider, or a 3PL partner.
model Fulfilment {
  id                String    @id @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  microMarketId     String    @map("micro_market_id") @db.Uuid
  /// self | rider | tpl
  mode              String
  /// searching | assigned | picked_up | delivered | failed | cancelled
  state             String
  staffId           String?   @map("staff_id") @db.Uuid
  /// Secret for the staff tracking link (/d/{token}); null for riders.
  staffToken        String?   @unique @map("staff_token")
  riderUserId       String?   @map("rider_user_id") @db.Uuid
  tplRef            String?   @map("tpl_ref")
  /// Shown on the store's order card; the courier enters it at pickup.
  pickupCode        String    @map("pickup_code")
  /// Shown to the customer; the courier enters it at the door.
  deliveryOtp       String    @map("delivery_otp")
  /// none | tpl | self_bonus | standby | customer_notified
  fallbackStage     String    @default("none") @map("fallback_stage")
  selfBonusPaise    Int       @default(0) @map("self_bonus_paise")
  storeToDropM      Int       @map("store_to_drop_m")
  riderPayPaise     Int       @default(0) @map("rider_pay_paise")
  payLines          Json      @default("[]") @map("pay_lines")
  batchedWith       String?   @map("batched_with") @db.Uuid
  promisedAt        DateTime  @map("promised_at") @db.Timestamptz(6)
  etaAt             DateTime? @map("eta_at") @db.Timestamptz(6)
  delayNotifiedAt   DateTime? @map("delay_notified_at") @db.Timestamptz(6)
  /// otp | photo
  proof             String?
  proofMediaId      String?   @map("proof_media_id") @db.Uuid
  codCollectedPaise Int?      @map("cod_collected_paise")
  lastLat           Float?    @map("last_lat")
  lastLng           Float?    @map("last_lng")
  lastLocationAt    DateTime? @map("last_location_at") @db.Timestamptz(6)
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  assignedAt        DateTime? @map("assigned_at") @db.Timestamptz(6)
  arrivedAt         DateTime? @map("arrived_at") @db.Timestamptz(6)
  pickedUpAt        DateTime? @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  offers DispatchOffer[]

  @@index([state, microMarketId])
  @@index([riderUserId, state])
  @@map("fulfilments")
}

/// One 30-second offer of a fulfilment to one rider.
model DispatchOffer {
  id           String    @id @db.Uuid
  fulfilmentId String    @map("fulfilment_id") @db.Uuid
  riderUserId  String    @map("rider_user_id") @db.Uuid
  /// offered | accepted | declined | expired | withdrawn
  state        String
  payPaise     Int       @map("pay_paise")
  payLines     Json      @map("pay_lines")
  distanceM    Int       @map("distance_m")
  offeredAt    DateTime  @map("offered_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz(6)

  fulfilment Fulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)

  @@index([riderUserId, state])
  @@index([fulfilmentId])
  @@map("dispatch_offers")
}

// ───────────── payments-settlement: settlement, refunds, reconciliation, disputes (M7) ─────────────

/// One settlement run: merchants daily (previous IST day), riders weekly (or daily for riders who chose it).
model SettlementRun {
  id          String    @id @db.Uuid
  /// merchant | rider
  kind        String
  periodStart DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime  @map("period_end") @db.Timestamptz(6)
  /// running | completed | failed
  status      String
  totals      Json      @default("{}")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  payouts Payout[]

  @@unique([kind, periodStart, periodEnd])
  @@map("settlement_runs")
}

/// What one store or rider is paid for a period, with the per-order lines and tax records.
model Payout {
  id            String    @id @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  /// merchant | rider
  partyType     String    @map("party_type")
  partyId       String    @map("party_id") @db.Uuid
  microMarketId String?   @map("micro_market_id") @db.Uuid
  periodStart   DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd     DateTime  @map("period_end") @db.Timestamptz(6)
  grossPaise    Int       @map("gross_paise")
  netPaise      Int       @map("net_paise")
  /// Per-order lines and totals (GST on commission, TCS, TDS) as computed.
  lines         Json
  totals        Json
  tcsPaise      Int       @default(0) @map("tcs_paise")
  tdsPaise      Int       @default(0) @map("tds_paise")
  /// pending | transferred | failed | on_hold (nothing to pay, or a negative balance carried forward)
  status        String
  transferRef   String?   @map("transfer_ref")
  failureReason String?   @map("failure_reason")
  statementKey  String?   @map("statement_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  transferredAt DateTime? @map("transferred_at") @db.Timestamptz(6)

  run SettlementRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, partyType, partyId])
  @@index([partyType, partyId, periodStart])
  @@map("payouts")
}

/// A refund to a customer, decided by the rules engine or a person (four-eyes above the threshold).
model RefundRequest {
  id            String    @id @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  issueId       String?   @map("issue_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  microMarketId String    @map("micro_market_id") @db.Uuid
  amountPaise   Int       @map("amount_paise")
  /// wallet | source
  destination   String
  /// merchant | platform | rider: who bears it (store-liable refunds reduce the next payout)
  liability     String
  reason        String
  /// pending | awaiting_second | processed | rejected | failed
  status        String
  /// [{ userId, at }]
  approvals     Json      @default("[]")
  rejectedBy    String?   @map("rejected_by") @db.Uuid
  rejectNote    String?   @map("reject_note")
  providerRef   String?   @map("provider_ref")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([merchantId, liability, processedAt])
  @@map("refund_requests")
}

/// Differences between captured payments and the aggregator settlement report.
model ReconException {
  id                String    @id @db.Uuid
  reportDate        String    @map("report_date")
  /// missing_in_report | amount_mismatch | unknown_in_report
  kind              String
  providerPaymentId String    @map("provider_payment_id")
  expectedPaise     Int?      @map("expected_paise")
  reportedPaise     Int?      @map("reported_paise")
  /// open | resolved
  status            String
  note              String?
  resolvedBy        String?   @map("resolved_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@unique([reportDate, providerPaymentId, kind])
  @@index([status])
  @@map("recon_exceptions")
}

/// A store disputes a refund charged to it (or a payout line) within 48 h, with evidence.
model Dispute {
  id               String    @id @db.Uuid
  merchantId       String    @map("merchant_id") @db.Uuid
  orderId          String?   @map("order_id") @db.Uuid
  refundId         String?   @map("refund_id") @db.Uuid
  payoutId         String?   @map("payout_id") @db.Uuid
  reason           String
  evidenceMediaIds String[]  @map("evidence_media_ids") @db.Uuid
  /// open | accepted | rejected
  status           String
  resolutionNote   String?   @map("resolution_note")
  /// Credited back to the store in its next payout when accepted.
  adjustmentPaise  Int       @default(0) @map("adjustment_paise")
  deadlineAt       DateTime  @map("deadline_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?   @map("resolved_by") @db.Uuid
  /// Payout that carried the adjustment.
  settledInPayout  String?   @map("settled_in_payout") @db.Uuid

  @@index([merchantId, status])
  @@index([status, createdAt])
  @@map("disputes")
}

// ───────────── trust-safety: issues and ratings (M7) ─────────────

/// A customer's problem with a delivered order.
model Issue {
  id            String    @id @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  /// missing_item | wrong_item | damaged | quality | late | not_delivered | return_request
  type          String
  /// Variant ids of the lines concerned (item issues).
  variantIds    String[]  @map("variant_ids") @db.Uuid
  description   String?
  photoMediaIds String[]  @map("photo_media_ids") @db.Uuid
  claimedPaise  Int       @map("claimed_paise")
  /// auto_resolved | pending_review | approved | rejected | return_pickup
  status        String
  trustScore    Float     @map("trust_score")
  decision      Json
  refundId      String?   @map("refund_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([merchantId, createdAt])
  @@index([orderId])
  @@map("issues")
}

/// One rating per delivered order: the store, and the rider when a rider delivered.
model Rating {
  orderId     String    @id @map("order_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  riderUserId String?   @map("rider_user_id") @db.Uuid
  storeStars  Int       @map("store_stars")
  riderStars  Int?      @map("rider_stars")
  comment     String?
  /// visible | flagged | hidden (comments are screened; ops moderates flagged ones, M8)
  status      String    @default("visible")
  flagReason  String?   @map("flag_reason")
  /// The store's public reply.
  reply       String?
  replyAt     DateTime? @map("reply_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([merchantId, createdAt])
  @@index([riderUserId])
  @@map("ratings")
}

// ───────────── M8: growth leads, grievances, DPDP consents and data requests ─────────────

/// A store, home kitchen or rider who asked to join from the website (/stores, /home-kitchens, /riders).
model Lead {
  id        String   @id @db.Uuid
  /// store | home_kitchen | rider
  kind      String
  name      String
  phone     String
  /// Shop or kitchen name (ADR-023)
  business  String?
  /// Shop type picked on the /stores form (ADR-023)
  category  String?
  area      String?
  message   String?
  locale    String   @default("en")
  /// new | contacted | converted | dropped
  status    String   @default("new")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("leads")
}

/// A grievance to the Grievance Officer (Consumer Protection (E-Commerce) Rules 2020): acknowledged
/// within 48 hours, resolved within one month.
model Grievance {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// consumer | merchant | rider
  app            String
  orderId        String?   @map("order_id") @db.Uuid
  /// order | payment | refund | account | privacy | other
  category       String
  description    String
  /// open | acknowledged | resolved
  status         String
  resolution     String?
  ackDueAt       DateTime  @map("ack_due_at") @db.Timestamptz(6)
  resolveDueAt   DateTime  @map("resolve_due_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  handledBy      String?   @map("handled_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("grievances")
}

/// Consent ledger (DPDP Act 2023): append-only; the latest row per user and purpose is in force.
model Consent {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// terms | privacy | whatsapp_updates | marketing
  purpose   String
  /// Notice version the person saw (e.g. privacy-2026-11)
  version   String
  granted   Boolean
  /// app | web | ops
  source    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose, createdAt])
  @@map("consents")
}

/// A data principal's request (DPDP Act 2023 s.11–13): access (export), correction or erasure.
model DataRequest {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// access | correction | erasure
  type        String
  details     String?
  /// open | completed | rejected
  status      String
  note        String?
  exportKey   String?   @map("export_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy String?   @map("completed_by") @db.Uuid

  @@index([status, createdAt])
  @@index([userId])
  @@map("data_requests")
}
