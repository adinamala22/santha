{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env -r @swc-node/register src/main.ts",
    "dev:fake": "node --watch --env-file-if-exists=../../.env -r @swc-node/register src/dev/fake-main.ts",
    "start:fake": "node --env-file-if-exists=../../.env -r @swc-node/register src/dev/fake-main.ts",
    "worker": "node --env-file-if-exists=../../.env -r @swc-node/register src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project fake",
    "test:unit": "vitest run --project unit",
    "test:fake": "vitest run --project fake",
    "test:int": "vitest run --project integration",
    "prisma": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file-if-exists=../../.env -r @swc-node/register prisma/seed.ts",
    "openapi:gen": "node -r @swc-node/register scripts/openapi-gen.ts",
    "postinstall": "prisma generate",
    "migrate:reset": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@prisma/client": "^6",
    "bullmq": "^5",
    "h3-js": "^4.5.0",
    "ioredis": "^5",
    "nestjs-pino": "^4",
    "nestjs-zod": "^5.5.0",
    "pino": "^9",
    "pino-http": "^10",
    "posthog-node": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typesense": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/testing": "^11",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.21",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "pino-pretty": "^13.2.0",
    "prisma": "^6",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7",
    "typescript-eslint": "^8",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3"
  }
}
