# /opt/santha/.env on a server: which environment this is, plus SECRETS only. Everything else (domains,
# providers, URLs) is committed in config/values/<env>.values.yaml. Fill in, then `chmod 600 .env`.
# Never commit the filled-in file. Details for each variable: config/values/secrets.md.

SANTHA_ENV=test                # test | prod
SANTHA_CLOUD=                  # optional overlay, e.g. gcp → config/values/gcp.prod.values.yaml
REGISTRY=ghcr.io/CHANGE_ME_GITHUB_OWNER
ACME_EMAIL=CHANGE_ME@santha.app

# Database. Test: the Postgres container (set LOCALDB_PASSWORD). Prod: the managed database URL with sslmode=require.
LOCALDB_PASSWORD=CHANGE_ME
# Port the test Postgres listens on at the server's 127.0.0.1, for SQL tools over SSH (default 5432).
LOCALDB_PORT=5432
DATABASE_URL=postgresql://santha:CHANGE_ME@postgres:5432/santha

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
TYPESENSE_API_KEY=CHANGE_ME

S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# WhatsApp login OTP (flag whatsapp_otp): only when the values file sets whatsappProvider: cloud
WHATSAPP_ACCESS_TOKEN=
FCM_SERVICE_ACCOUNT_B64=
GOOGLE_MAPS_SERVER_KEY=
POSTHOG_KEY=

BACKUP_S3_ENDPOINT=CHANGE_ME
BACKUP_S3_BUCKET=santha-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_KEEP_DAYS=7

# Only when the values file sets deploy.ingress: tunnel (no public ports; Cloudflare Tunnel). See docs/deploy/README.md.
CLOUDFLARE_TUNNEL_TOKEN=
