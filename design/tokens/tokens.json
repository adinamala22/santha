{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Santha",
  "version": "1.0.0",
  "color": {
    "indigo":      { "value": "#1F2A5C", "description": "Santha Indigo — primary brand, pin body, headlines, nav" },
    "indigo700":   { "value": "#16204A", "description": "Pressed states, dark surfaces" },
    "indigo300":   { "value": "#8A93B8", "description": "Secondary text on dark, dividers" },
    "indigo100":   { "value": "#E6E9F4", "description": "Light tints, cards, borders" },
    "marigold":    { "value": "#F5A623", "description": "Market Marigold — awning, accents, primary CTA" },
    "marigold600": { "value": "#D98C0F", "description": "CTA hover / pressed" },
    "marigold100": { "value": "#FDEBC8", "description": "Highlights, badges" },
    "cream":       { "value": "#FFF8EC", "description": "Warm backgrounds, shop facade, reverse pin" },
    "slate":       { "value": "#5B6478", "description": "Body text, taglines" },
    "ink":         { "value": "#1A1D29", "description": "Primary text on light" },
    "leaf":        { "value": "#2E9E6B", "description": "Success, veg indicator, delivered" },
    "chilli":      { "value": "#D9453D", "description": "Errors, non-veg indicator" },
    "sky":         { "value": "#EAF0FF", "description": "App background tint" },
    "white":       { "value": "#FFFFFF", "description": "Surfaces" }
  },
  "font": {
    "display": { "value": "Poppins", "weights": [700], "use": "wordmark, headlines" },
    "ui":      { "value": "Poppins", "weights": [400, 500, 700], "use": "labels, buttons, body" },
    "telugu":  { "value": "Noto Sans Telugu", "weights": [400, 500, 600, 700], "use": "all Telugu UI text" }
  },
  "typeScale": {
    "display": { "size": 32, "lineHeight": 38, "weight": 700 },
    "h1":      { "size": 24, "lineHeight": 30, "weight": 700 },
    "h2":      { "size": 20, "lineHeight": 26, "weight": 700 },
    "h3":      { "size": 16, "lineHeight": 22, "weight": 500 },
    "body":    { "size": 14, "lineHeight": 20, "weight": 400 },
    "bodyM":   { "size": 14, "lineHeight": 20, "weight": 500 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
    "micro":   { "size": 10, "lineHeight": 14, "weight": 500 }
  },
  "radius": { "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "elevation": {
    "card": "0 1px 2px rgba(31,42,92,0.06), 0 4px 12px rgba(31,42,92,0.06)",
    "sheet": "0 -4px 24px rgba(31,42,92,0.12)"
  },
  "semantic": {
    "ctaPrimary":   { "bg": "{color.indigo}",   "fg": "{color.white}",  "pressed": "{color.indigo700}" },
    "ctaAccent":    { "bg": "{color.marigold}", "fg": "{color.indigo}", "pressed": "{color.marigold600}" },
    "etaChip":      { "bg": "#E3F4EB",          "fg": "{color.leaf}" },
    "selfDelivers": { "bg": "{color.marigold100}", "fg": "{color.indigo}" },
    "veg":          { "value": "{color.leaf}" },
    "nonVeg":       { "value": "{color.chilli}" },
    "surface":      { "page": "{color.white}", "pageAlt": "{color.sky}", "warm": "{color.cream}", "card": "{color.white}", "border": "{color.indigo100}" },
    "text":         { "primary": "{color.ink}", "secondary": "{color.slate}", "onDark": "{color.white}", "onDarkMuted": "#C9CFE3" }
  },
  "logo": {
    "clearSpace": "height of the pin head on all sides",
    "minLockupWidthPx": 120,
    "minMarkPx": 24,
    "files": { "primary": "design/brand/logo/santha-primary.svg", "mark": "design/brand/logo/santha-mark.svg", "reverse": "design/brand/logo/santha-primary-reverse.svg", "appIcon": "design/brand/app-icon/santha-app-icon.svg" }
  }
}
